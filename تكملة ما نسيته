4. Loan.java;

package library.model;

import java.time.LocalDate;

public class Loan {

    private final LocalDate loanDate;
    private final LocalDate dueDate;
    private LocalDate returnDate;

    private final Member member;
    private final Copy copy;

    Loan(Member member, Copy copy, LocalDate loanDate) {
        this.member = member;
        this.copy = copy;
        this.loanDate = loanDate;
        this.dueDate = loanDate.plusDays(14);

        member.addLoan(this);
        copy.addLoan(this);
    }

    public LocalDate getLoanDate() {
        return loanDate;
    }

    public LocalDate getDueDate() {
        return dueDate;
    }

    public LocalDate getReturnDate() {
        return returnDate;
    }
    public Member getMember() {
        return member;
    }
    public Copy getCopy() {
        return copy;
    }
    public boolean isClosed() {
        return returnDate != null;
    }
    public boolean isLate(LocalDate today) {
        LocalDate effectiveDate =
                returnDate == null ? today : returnDate;
        return effectiveDate.isAfter(dueDate);
    }
    public void close(LocalDate date) {
        if (isClosed())
            throw new IllegalStateException("Loan already closed");
        returnDate = date;
        copy.makeAvailable();
    }
}


5. Reservation.java;

package library.model;

import java.time.LocalDate;
public class Reservation {
    private final LocalDate date;
    private final Member member;
    private final Book book;
    Reservation(Member member, Book book, LocalDate date) {
        this.member = member;
        this.book = book;
        this.date = date;
        member.addReservation(this);
        book.addReservation(this);
    }
    public LocalDate getDate() {
        return date;
    }
    public Member getMember() {
        return member;
    }
    public Book getBook() {
        return book;
    }
}



























