
@startuml object-diagram

skinparam objectAttributeIconSize 0

object "a1 : Author" as a1 {
  name = "First author"
}

object "a2 : Author" as a2 {
  name = "Second author"
}

object "b : Book" as b {
  isbn = "978-0-00-000001-1"
  title = "Software Engineering"
  year = 2016
}

object "c1 : Copy" as c1 {
  inventoryNumber = "C-001"
  status = BORROWED
}

object "c2 : Copy" as c2 {
  inventoryNumber = "C-002"
  status = BORROWED
}

object "s1 : StudentMember" as s1 {
  memberNumber = "M-01"
  name = "Student 1"
  email = "s1@example.org"
  level = "L3"
}

object "t1 : TeacherMember" as t1 {
  memberNumber = "M-02"
  name = "Teacher 1"
  email = "t1@example.org"
  department = "Computer Science"
}

object "l1 : Loan" as l1 {
  loanDate = 2026-10-01
  dueDate = 2026-10-15
}

object "l2 : Loan" as l2 {
  loanDate = 2026-10-01
  dueDate = 2026-10-15
}

object "r1 : Reservation" as r1 {
  date = 2026-10-02
}

b -- a1
b -- a2

b -- c1
b -- c2

s1 -- l1
s1 -- l2

l1 -- c1
l2 -- c2

t1 -- r1
r1 -- b

@enduml
