1. Test
ModelTest:

@Test
void objectDiagramSituation() {

    Author author2 = new Author("Second author");

    book.addAuthor(author2);

    Copy copy2 = new Copy("C-002", book);

    student.borrow(copy, DAY);
    student.borrow(copy2, DAY);

    Member teacher = new TeacherMember(
            "T-03",
            "Teacher",
            "t3@example.org",
            "CS"
    );

    Reservation reservation =
            teacher.reserve(book, DAY.plusDays(1));

    assertEquals(2, book.getAuthors().size());
    assertEquals(2, book.getCopies().size());

    assertEquals(2, student.getLoans().size());

    assertTrue(copy.getLoans().contains(
            student.getLoans().get(0)));

    assertTrue(copy2.getLoans().contains(
            student.getLoans().get(1)));

    assertTrue(teacher.getReservations().contains(reservation));

    assertEquals(reservation, book.firstReservation());
}

